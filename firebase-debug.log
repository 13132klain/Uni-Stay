[debug] [2025-07-06T20:21:47.238Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/unistay-e18e3/rulesets {"name":"projects/unistay-e18e3/rulesets/c038742c-a6e9-4166-a019-ba82a1f717d4","source":{"files":[{"content":" service cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Users: Only the user can read/write their own profile\n    match /users/{userId} {\n      allow read, write: if request.auth != null && request.auth.uid == userId;\n    }\n\n    // Houses: Anyone can read, only the owner or admin can write\n    match /houses/{houseId} {\n      allow read: if true;\n      allow write: if request.auth != null && (\n        request.auth.uid == resource.data.ownerId ||\n        request.auth.token.admin == true\n      );\n    }\n\n    // Bookings: Only the user who made the booking, the house owner, or an admin can read/write\n    match /bookings/{bookingId} {\n      allow read: if request.auth != null && (\n        request.auth.uid == resource.data.userId ||\n        request.auth.token.admin == true\n      );\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\n      allow update, delete: if request.auth != null && (\n        request.auth.uid == resource.data.userId ||\n        request.auth.token.admin == true\n      );\n    }\n\n    // Inquiries: Users can create and read their own inquiries, admins can read and update all\n    match /inquiries/{inquiryId} {\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\n      allow read: if request.auth != null && (\n        request.auth.uid == resource.data.userId || \n        request.auth.token.admin == true\n      );\n      allow update: if request.auth != null && request.auth.token.admin == true;\n      allow delete: if request.auth != null && request.auth.token.admin == true;\n    }\n\n    // Roommate Profiles: Only the user can read/write their own roommate profile\n    match /roommateProfiles/{userId} {\n      allow read, write: if request.auth != null && request.auth.uid == userId;\n    }\n\n    // Payments: Users can create and read their own payments, admins can read all\n    match /payments/{paymentId} {\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\n      allow read: if request.auth != null && (\n        request.auth.uid == resource.data.userId || \n        request.auth.token.admin == true\n      );\n      allow update: if request.auth != null && request.auth.token.admin == true;\n    }\n  }\n}","name":"firestore.rules"}]},"createTime":"2025-07-06T20:21:46.717887Z","metadata":{"services":["cloud.firestore"]}}
